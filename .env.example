# ================================================================
# openerp-jud — variáveis de ambiente
# Copie para .env e ajuste. Nunca commite .env nem certificados.
# ================================================================

DOCKER_USERNAME=rafapasa
IMAGE_TAG=latest
APP_PORT=8080

ENVIRONMENT=development
TIME_ZONE=America/Sao_Paulo

# MCP: stdio | sse
MCP_TRANSPORT=sse
PORT=8080

# Certificado ICP-Brasil A1 (caminho DENTRO do container ou relativo no host local)
CERT_PATH=certs/advogado.pfx
CERT_PASSWORD=

# Host paths montados no compose (opcional)
CERTS_HOST_PATH=./certs
DOWNLOADS_HOST_PATH=./tmp/downloads
LOGS_HOST_PATH=./logs

# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_SEC=45
DOWNLOADS_DIR=tmp/downloads

# Logging
LOG_LEVEL=info
LOG_ENCODING=json
LOG_OUTPUT=stdout
LOG_FILE=logs/mcp-server.log
